RewriteEngine On
Options All -Indexes

# Permitir acceso a: (me toco cambiarlo :)
# - La ruta base (con o sin barra final)
# - index.php
# - Carpeta recursos y todo su contenido
# - Carpeta vendor y todo su contenido  
# - Carpeta vista y todo su contenido
RewriteCond %{REQUEST_URI} !^/haydee-app/?$
RewriteCond %{REQUEST_URI} !^/haydee-app/index\.php$
RewriteCond %{REQUEST_URI} !^/haydee-app/recursos/ [OR]
RewriteCond %{REQUEST_URI} !^/haydee-app/vendor/ [OR] 
RewriteCond %{REQUEST_URI} !^/haydee-app/vista/
RewriteRule .* - [S=4]  # Salta las próximas 4 reglas si alguna condición anterior es verdadera

# Bloquear todo lo demás
RewriteRule ^ - [F]