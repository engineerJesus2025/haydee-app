ErrorDocument 404 /haydee-app/vista/error/404_vista.php
ErrorDocument 403 /haydee-app/vista/error/403_vista.php

RewriteEngine On
Options All -Indexes

# Permitir acceso a:
# - La ruta base
# - index.php
# - Carpeta recursos, vendor y vista
RewriteCond %{REQUEST_URI} !^/haydee/?$
RewriteCond %{REQUEST_URI} !^/haydee/index\.php$
RewriteCond %{REQUEST_URI} !^/haydee/recursos/ [OR]
RewriteCond %{REQUEST_URI} !^/haydee/vendor/ [OR] 
RewriteCond %{REQUEST_URI} !^/haydee/vista/
RewriteRule .* - [S=4]  

# Bloquear todo lo demás (Error 403)
RewriteRule ^ - [F]