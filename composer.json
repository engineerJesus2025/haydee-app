{
    "autoload": {
        "psr-4": {
          "haydee\\controlador\\": "controlador/",
          "haydee\\modelo\\": "modelo/",
          "haydee\\vista\\": "vista/",
          "haydee\\ayuda\\": "ayuda/",
          "haydee\\servicios\\": "servicios/"
        },
        "files": [
            "config/acciones.php",
            "config/modulos.php",
            "config/config.php"
        ]
    },
    "require": {
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "sendgrid/sendgrid": "^8.1",
        "php-http/guzzle7-adapter": "^1.1",
        "nyholm/psr7": "^1.8",
        "mailersend/mailersend": "^0.34.0",
        "resend/resend-php": "^0.18.0",
        "phpmailer/phpmailer": "^6.10",
        "php-webdriver/webdriver": "^1.15",
        "phpxmlrpc/phpxmlrpc": "^4.11"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
