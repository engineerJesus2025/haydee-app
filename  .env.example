# ========================================
# CONFIGURACIÓN DEL SISTEMA - EJEMPLO
# ========================================
# Locos, si leen esto. Usen este archivo como .env y reemplaza los valores de ejemplo
# con tus credenciales reales. NUNCA subas el .env al repositorio.

# ----------------------------------------
# Base de Datos Principal
# ----------------------------------------
DB_NAME="nombre_bd_principal"
DB_HOST="localhost"
DB_USER="usuario_bd"
DB_PASS="contraseña_segura"
DB_SECURITY="nombre_bd_seguridad"

# ----------------------------------------
# Google reCAPTCHA
# ----------------------------------------
CLAVE_SITIO_RECAPTCHA="6LdXXXXXXXXXXXXXX"
CLAVE_SECRETA_RECAPTCHA="6LdXXXXXXXXXXXXXX"

# ----------------------------------------
# Correo Electrónico (SMTP y API)
# ----------------------------------------
API_CORREO="re_xxxxxxxxxxxxxxxxxxxx"  # API key para servicios como Resend
SMTP_HOST="smtp.ejemplo.com"
SMTP_USER="usuario@ejemplo.com"
SMTP_PASS="contraseña_smtp"

# ----------------------------------------
# Configuración General de la Aplicación
# ----------------------------------------
URL_BASE="http://localhost/mi_proyecto/"
ENTORNO="local"   # Valores comunes: local y produccion